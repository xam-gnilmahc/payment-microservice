                <mxCell id="tLog" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="payment_logs&#xa;id, customer_id, event,&#xa;status, gateway, amount,&#xa;currency, transaction_id,&#xa;charge_id, card_brand,&#xa;card_last4, payment_method,&#xa;message, created_at" vertex="1">
