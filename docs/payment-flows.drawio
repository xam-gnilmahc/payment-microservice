                    <mxGeometry x="80" y="460" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="payment_gateways&#xa;id, title, description,&#xa;image, status, created_by" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="560" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="user_payment_gateways&#xa;id, user_id, payment_gateway_id,&#xa;enabled" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="660" width="140" height="80" as="geometry"/>
