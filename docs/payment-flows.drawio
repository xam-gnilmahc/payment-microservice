    <diagram id="payment-flow" name="Payment Flow">
        <mxGraphModel dx="975" dy="631" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="960" math="0" shadow="0">
            <root>
