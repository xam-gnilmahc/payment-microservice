                    <mxGeometry height="80" width="220" x="380" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="pa2a" edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;fontStyle=0;fontSize=10;" target="p3" value="Gateway = Stripe">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pa2b" edge="1" parent="1" source="p2" style="edgeStyle=orthogonalEdgeStyle;fontStyle=0;fontSize=10;" target="pNotStripe" value="Gateway ≠ Stripe">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pNotStripe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="Return: {status: &#39;pending&#39;,&#xa;message: &#39;Gateway not configured&#39;}" vertex="1">
                    <mxGeometry height="50" width="200" x="680" y="95" as="geometry"/>
                </mxCell>
                <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" value="3. Get Secret Key from&#xa;user_payment_credentials" vertex="1">
                    <mxGeometry height="60" width="220" x="380" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="pa3" edge="1" parent="1" source="p3" style="edgeStyle=orthogonalEdgeStyle;" target="p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" value="4. Stripe: Create PaymentIntent" vertex="1">
                    <mxGeometry height="60" width="220" x="380" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="p4d" parent="1" style="text;html=1;fontSize=10;align=center;" value="StripeService.createPaymentIntent()&#xa;→ {amount, currency}" vertex="1">
                    <mxGeometry height="30" width="220" x="380" y="385" as="geometry"/>
                </mxCell>
                <mxCell id="pa4" edge="1" parent="1" source="p4" style="edgeStyle=orthogonalEdgeStyle;" target="p5">
