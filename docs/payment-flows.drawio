                </mxCell>
                <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="5. Return to Frontend" vertex="1">
                    <mxGeometry height="50" width="220" x="380" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="p5d" parent="1" style="text;html=1;fontSize=10;align=center;" value="{paymentIntentId, clientSecret, status}" vertex="1">
                    <mxGeometry height="25" width="220" x="380" y="495" as="geometry"/>
                </mxCell>
                <mxCell id="pa5" edge="1" parent="1" source="p5" style="edgeStyle=orthogonalEdgeStyle;" target="p6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="6. Frontend: Confirm Payment&#xa;(Stripe.js handles card/3DS)" vertex="1">
                    <mxGeometry height="60" width="220" x="380" y="550" as="geometry"/>
                </mxCell>
