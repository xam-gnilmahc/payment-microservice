<mxfile host="65bd71144e">
    <diagram id="payment-gateway-flow" name="Gateway Setup Flow">
        <mxGraphModel dx="1365" dy="572" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title1" value="FLOW 1: User + Payment Gateway + Credentials Setup" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="1. User Registration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="100" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s1d" value="POST /api/v1/auth/register&#xa;{name, email, password}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="80" y="165" width="180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s1" target="s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="2. Admin Creates Payment Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="340" y="100" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s2d" value="POST /api/v1/payment-gateways&#xa;{title, description, image, status}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="340" y="165" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s2" target="s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="3. Assign Gateway to User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="100" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s3d" value="POST /api/v1/payment-gateways/user&#xa;{userId, paymentGatewayId, enabled}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="640" y="165" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s3" target="s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="4. Add API Credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="280" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s4d" value="POST /api/v1/payment-gateways/credentials&#xa;{userPaymentGatewaysId, publicKey,&#xa;secretKey, webhookSecret, metadata}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="620" y="345" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s4" target="s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="5. User Logs In" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="440" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s5d" value="POST /api/v1/auth/login&#xa;{email, password} → JWT Token" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="640" y="505" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s5" target="s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s6" value="6. User Selects Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="580" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s6d" value="GET /api/v1/payment-gateways/user/{userId}/details&#xa;→ Shows enabled gateways with credentials status" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="590" y="645" width="300" height="40" as="geometry"/>
