                    <mxGeometry x="260" y="660" width="160" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="payment-flow" name="Payment Flow">
        <mxGraphModel dx="1365" dy="572" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title2" value="FLOW 2: Payment Processing (Stripe)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="250" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="1. Create Payment Intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="100" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p1d" value="Frontend → POST /api/v1/payments&#xa;{customerId, gatewayId, amount,&#xa;name, email, address...}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="165" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pa1" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p1" target="p2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="2. Backend: Check Gateway Type" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="90" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pa2a" value="Gateway = Stripe" style="edgeStyle=orthogonalEdgeStyle;fontStyle=0;fontSize=10;" parent="1" source="p2" target="p3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pa2b" value="Gateway ≠ Stripe" style="edgeStyle=orthogonalEdgeStyle;fontStyle=0;fontSize=10;" parent="1" source="p2" target="pNotStripe" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pNotStripe" value="Return: {status: &#39;pending&#39;,&#xa;message: &#39;Gateway not configured&#39;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="680" y="95" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="3. Get Secret Key from&#xa;user_payment_credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="220" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="pa3" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p3" target="p4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="4. Stripe: Create PaymentIntent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="320" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4d" value="StripeService.createPaymentIntent()&#xa;→ {amount, currency}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="380" y="385" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="pa4" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p4" target="p5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5" value="5. Return to Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="440" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p5d" value="{paymentIntentId, clientSecret, status}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="380" y="495" width="220" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="pa5" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p5" target="p6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6" value="6. Frontend: Confirm Payment&#xa;(Stripe.js handles card/3DS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="550" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6d" value="stripe.confirmCardPayment(clientSecret,&#xa;{payment_method: {card: cardElement,&#xa;billing_details: {...}}})" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="350" y="615" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pa6" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p6" target="p7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7" value="7. Backend: Confirm &amp; Log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="690" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p7d" value="POST /api/v1/payments/confirm&#xa;{paymentIntentId, customerId,&#xa;gatewayId, paymentMethod}" style="text;html=1;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="370" y="745" width="240" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="pa7" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p7" target="p8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8" value="8. Stripe: Get PaymentIntent Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="810" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pa8a" value="succeeded" style="edgeStyle=orthogonalEdgeStyle;fontStyle=0;fontSize=10;" parent="1" source="p8" target="pSuccess" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pSuccess" value="Log: chargeId, cardLast4,&#xa;cardBrand, amount, paymentMethod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="680" y="800" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pa8b" value="failed" style="edgeStyle=orthogonalEdgeStyle;fontStyle=0;fontSize=10;" parent="1" source="p8" target="pFailed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pFailed" value="Log: status=FAILED,&#xa;message=error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="680" y="870" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="db2" value="payment_logs TABLE" style="text;html=1;fontSize=14;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="80" y="560" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="tLog" value="payment_logs&#xa;id, customer_id, event,&#xa;status, gateway, amount,&#xa;currency, transaction_id,&#xa;charge_id, card_brand,&#xa;card_last4, payment_method,&#xa;message, created_at" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="600" width="160" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
